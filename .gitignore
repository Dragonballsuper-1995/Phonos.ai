# ==============================================================================
# Phonos.ai - Production-Grade Git Ignore Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (Security Critical)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
apps/api/.env
apps/web/.env.local
apps/web/.env.*.local
*.env

# ------------------------------------------------------------------------------
# 2. Node.js & Next.js Builds
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vercel/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 3. Python, Virtual Environments & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.class
.Python
.venv/
venv/
ENV/
env/
develop-eggs/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
apps/api/lib/
apps/api/lib64/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
=3.0.0
apps/api/=3.0.0

# ------------------------------------------------------------------------------
# 4. Testing, Coverage & Profiling
# ------------------------------------------------------------------------------
.pytest_cache/
apps/api/.pytest_cache/
coverage/
.coverage
.coverage.*
htmlcov/
playwright-report/
test-results/

# ------------------------------------------------------------------------------
# 5. Databases, Vector Stores & Runtime Caches
# ------------------------------------------------------------------------------
*.db-shm
*.db-wal
*.db-journal
*.sqbpro
apps/api/fone_master.db
apps/api/phonos.db
apps/api/data/pricing_cache.db
apps/api/data/feedback_events.db
apps/api/data/chroma_db/
docker-data/
postgres_data/

# ------------------------------------------------------------------------------
# 6. Data Dumps & Intermediate CSVs
# ------------------------------------------------------------------------------
apps/api/data/*.csv
!apps/api/data/absa_phone_summary.csv

# ------------------------------------------------------------------------------
# 7. Evaluation Reports & Test Dumps
# ------------------------------------------------------------------------------
evaluation_results.json
evaluation_confidence_report.json
apps/evaluation_results.json
apps/api/evaluation_confidence_report.json
*.log
.tempmediaStorage/

# ------------------------------------------------------------------------------
# 8. IDE, OS & Assistant Artifacts
# ------------------------------------------------------------------------------
.vscode/
.idea/
.claude/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
*.stackdump

# ------------------------------------------------------------------------------
# 9. Transcripts, Scratch Notes & Visual Testing Captures
# ------------------------------------------------------------------------------
Previous Conversations/
Models(Nvidia)/
github_action_error/
screenshots/*
!screenshots/system_architecture.png
